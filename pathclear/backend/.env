# Application Settings
PROJECT_NAME="PathClear Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Settings (frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Settings (PostgreSQL + PostGIS / Supabase)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/pathclear"

# Supabase Integration (Optional direct service role access)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Routing & Map Services
MAPBOX_ACCESS_TOKEN=""
ORSTOOLS_API_KEY=""
