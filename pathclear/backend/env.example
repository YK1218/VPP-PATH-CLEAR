# ==========================================
# PathClear Backend Environment Variables
# ==========================================

# 1. Supabase Configuration
# How to get: Go to your Supabase Dashboard -> Settings (gear icon) -> API
# Use the "Project URL" and the "anon" "public" key.
SUPABASE_URL=
SUPABASE_KEY=

# 2. Neo4j Configuration
# How to get: 
# - If running locally via Neo4j Desktop: URI is usually bolt://localhost:7687, default user is 'neo4j', and you set the password when creating the DBMS.
# - If using Neo4j AuraDB (Cloud Free Tier): Get the URI (neo4j+s://...), user (neo4j), and password from the instance connection details.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
